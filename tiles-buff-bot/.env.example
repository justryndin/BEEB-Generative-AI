# Название сайта (в шапке и вкладке браузера)
SITE_NAME=Бафы союза

# Как сайт выходит в интернет:
#   direct — напрямую на отдельном IP сервера (SITE_IP + SITE_DOMAIN), HTTPS через Caddy
#   tunnel — через Cloudflare Tunnel (TUNNEL_TOKEN), порты не нужны
COMPOSE_PROFILES=direct

# Для direct: домен и отдельный IP сервера, на котором будет сайт
SITE_DOMAIN=olp-olimp.online
SITE_IP=129.101.125.161

# Для tunnel: токен из панели Cloudflare (см. README)
TUNNEL_TOKEN=

# Часовой пояс для дат и статистики
TZ=Europe/Moscow

# 1 — cookies только по HTTPS (так и нужно через Cloudflare). 0 — только для локальной проверки.
SECURE_COOKIES=1
