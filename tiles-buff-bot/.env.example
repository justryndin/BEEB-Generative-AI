# Название сайта (в шапке и вкладке браузера)
SITE_NAME=Бафы союза

# Токен Cloudflare Tunnel (длинная строка из панели Cloudflare, см. README)
TUNNEL_TOKEN=

# Часовой пояс для дат и статистики
TZ=Europe/Moscow

# 1 — cookies только по HTTPS (так и нужно через Cloudflare). 0 — только для локальной проверки.
SECURE_COOKIES=1
